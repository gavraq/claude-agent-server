# JWT Secret for authentication (must match Vercel environment variable)
JWT_SECRET=your-jwt-secret-here

# Server Configuration
PORT=8090
NODE_ENV=production
LOG_LEVEL=info

# Paths (configured in docker-compose.yml volumes)
UFC_PATH=/ufc
CLAUDE_CONFIG_PATH=/claude-config
VAULT_PATH=/vault
DOCUMENTS_PATH=/documents
PROJECTS_PATH=/projects

# Claude CLI Authentication
# Run: docker exec -it claude-agent-server claude auth login
# This will store credentials in the claude-auth volume
